  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules,firestore:indexes",
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
